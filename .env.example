# Acuity Scheduling REST API v1 credentials
# Find these in Acuity Scheduling -> Integrations -> API -> View Credentials
# Keep these strictly server-side (never prefix with NEXT_PUBLIC_)
ACUITY_USER_ID=
ACUITY_API_KEY=

# Optional override for the studio IANA timezone (defaults to calendar/account timezone or America/New_York)
# ACUITY_TIMEZONE=America/New_York

# Optional canonical site URL for SEO, sitemap, OpenGraph, and AI discovery files (defaults to https://prettinessnails.com)
# NEXT_PUBLIC_SITE_URL=https://prettinessnails.com
