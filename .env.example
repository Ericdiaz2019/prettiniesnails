# Acuity Scheduling REST API credentials
# Find these in Acuity Scheduling -> Integrations -> API
# Keep real credentials in .env or .env.local (gitignored) and in your Vercel Project Settings.
ACUITY_USER_ID=
ACUITY_API_KEY=

# Optional: override the studio IANA timezone used for displaying availability.
# Defaults to the primary calendar / account timezone returned by Acuity,
# falling back to America/Indiana/Indianapolis (Granger, IN).
# ACUITY_TIMEZONE=America/Indiana/Indianapolis
